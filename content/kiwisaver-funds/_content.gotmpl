{{/* Content adapter: generates a page per scheme from data/finder/schemes.json.
     Stage 1 is scheme level only. Fund and category pages arrive with stage 2. */}}
{{ range site.Data.finder.schemes }}
  {{ if eq .status "open" }}
  {{ $scheme := . }}
  {{/* SEO: title per the dev notes; "| BetterSaver" only while the total stays under 60 chars.
       Meta description is generated with real figures (135-155 chars). */}}
  {{ $title := printf "%s: Funds, Fees & Review" .scheme_name }}
  {{ if lt (add (len $title) 14) 60 }}{{ $title = printf "%s | BetterSaver" $title }}{{ end }}
  {{ $desc := "" }}
  {{ $N := int .fund_count }}{{ $R := int .rec_count }}
  {{ if eq $N 1 }}
    {{ $state := cond (gt $R 0) "makes" "doesn't currently make" }}
    {{ $desc = printf "%s's only KiwiSaver fund %s our recommended list. Its fee and five-year return are compared against the category average." .provider_name $state }}
  {{ else }}
    {{ $desc = printf "%d of %s's %d KiwiSaver funds make our recommended list. Fees average %.2f%%, with five-year returns compared against category averages." $R .provider_name $N (float .avg_fee_pct) }}
  {{ end }}
  {{ $page := dict
    "path" .scheme_slug
    "kind" "page"
    "title" .scheme_name
    "params" (dict
      "record_type" "scheme"
      "scheme" $scheme
      "description" $desc
      "seo" (dict "title" $title "description" $desc)
    )
  }}
  {{ $.AddPage $page }}
  {{ end }}
{{ end }}
